using System;
using System.Collections.Generic;
using System.Linq;

public class ResultadoAGM
{
    public List<(int, int, double)> _arestas;   
    public double _custoTotal;                 

    public ResultadoAGM(List<(int, int, double)> arestas, double custoTotal)
    {
        _arestas = arestas;
        _custoTotal = custoTotal;
    }
}

public class AGMPrim
{
    public static ResultadoAGM CalcularAGM(Grafo grafo, int verticeRaiz = 0)
    {
        int numVertices = grafo.NumVertices;
        var novoGrafo = ConverterParaNaoDirecionado(grafo);

        var verticesAGM = new HashSet<int>();
        var arestasAGM = new List<(int, int, double)>();  
        double custoTotal = 0;                            

        verticesAGM.Add(verticeRaiz);

        while (verticesAGM.Count < numVertices)
        {
            double menorCusto = double.MaxValue;          
            int verticeOrigem = -1;
            int verticeDestino = -1;

            foreach (int vertice in verticesAGM)
            {
                if (novoGrafo.ContainsKey(vertice))
                {
                    foreach (var vizinhoInfo in novoGrafo[vertice])
                    {
                        int vizinho = vizinhoInfo.Item1;
                        double peso = vizinhoInfo.Item2;  

                        if (!verticesAGM.Contains(vizinho) && peso < menorCusto)
                        {
                            menorCusto = peso;
                            verticeOrigem = vertice;
                            verticeDestino = vizinho;
                        }
                    }
                }
            }

            if (verticeOrigem == -1)
            {
                throw new InvalidOperationException("O grafo não é conexo. Não é possível calcular AGM.");
            }

            verticesAGM.Add(verticeDestino);
            arestasAGM.Add((verticeOrigem, verticeDestino, menorCusto));
            custoTotal += menorCusto;
        }

        return new ResultadoAGM(arestasAGM, custoTotal);
    }

    private static Dictionary<int, List<(int, double)>> ConverterParaNaoDirecionado(Grafo grafo)  
    {
        var novoGrafo = new Dictionary<int, List<(int, double)>>();  
        int numVertices = grafo.NumVertices;

        for (int i = 0; i < numVertices; i++)
        {
            novoGrafo[i] = new List<(int, double)>();  
        }

        for (int origem = 0; origem < numVertices; origem++)
        {
            foreach (var vizinhoInfo in grafo.ObterVizinhos(origem))
            {
                int destino = vizinhoInfo.destino;
                double peso = vizinhoInfo.peso;  

                if (origem < destino)
                {
                    novoGrafo[origem].Add((destino, peso));
                    novoGrafo[destino].Add((origem, peso));
                }
            }
        }

        return novoGrafo;
    }

    public static void ExibirResultados(ResultadoAGM resultado)
    {
        Console.WriteLine("=== ÁRVORE GERADORA MÍNIMA ===");
        Console.WriteLine($"Custo Total da Rede: R$ {resultado._custoTotal:F2}");  
        Console.WriteLine("Arestas da AGM:");

        foreach (var (origem, destino, peso) in resultado._arestas)
        {
            char hubOrigem = (char)('A' + origem);
            char hubDestino = (char)('A' + destino);
            Console.WriteLine($"  Hub {hubOrigem} -> Hub {hubDestino} : R$ {peso:F2}");  
        }
        Console.WriteLine();
    }
}
